<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Regular: Weight 400 -->
    <font
        android:font="@font/sf_pro_rounded_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/sf_pro_rounded_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <!-- Medium: Weight 500 -->
    <font
        android:font="@font/sf_pro_rounded_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/sf_pro_rounded_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <!-- SemiBold: Weight 600 -->
    <font
        android:font="@font/sf_pro_rounded_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/sf_pro_rounded_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <!-- Bold: Weight 700 -->
    <font
        android:font="@font/sf_pro_rounded_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/sf_pro_rounded_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>