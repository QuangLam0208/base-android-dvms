<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.base.android.R" />

        <variable
            name="vm"
            type="com.base.android.ui.main.account.profile.ProfileViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/layout_bottom_sheet_theme_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_dark"
        android:backgroundTint="?attr/colorBottomSheetBackground"
        app:bgTintResByMode="@{R.color.color_bottom_sheet_background}"
        app:isNightMode="@{vm.isNightMode}"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_24sdp">

        <View
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:id="@+id/tv_bottom_sheet_theme_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:text="@string/choose_theme_title"
            android:textColor="?attr/colorTextPrimary"
            app:textColorResByMode="@{R.color.color_text_primary}"
            app:isNightMode="@{vm.isNightMode}"
            android:textSize="18sp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600" />

        <!-- Option: Dark -->
        <LinearLayout
            android:id="@+id/btn_theme_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_14sdp">

            <TextView
                android:id="@+id/tv_theme_dark_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_dark"
                android:textColor="?attr/colorTextPrimary"
                app:textColorResByMode="@{R.color.color_text_primary}"
                app:isNightMode="@{vm.isNightMode}"
                android:textSize="16sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />

            <ImageView
                android:id="@+id/iv_check_dark"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_circle_outline" />
        </LinearLayout>

        <View
            android:id="@+id/divider_dark"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:background="?attr/colorBottomSheetDivider"
            app:bgColorResByMode="@{R.color.color_bottom_sheet_divider}"
            app:isNightMode="@{vm.isNightMode}" />

        <!-- Option: Light -->
        <LinearLayout
            android:id="@+id/btn_theme_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_14sdp">

            <TextView
                android:id="@+id/tv_theme_light_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_light"
                android:textColor="?attr/colorTextPrimary"
                app:textColorResByMode="@{R.color.color_text_primary}"
                app:isNightMode="@{vm.isNightMode}"
                android:textSize="16sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />

            <ImageView
                android:id="@+id/iv_check_light"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_circle_outline" />
        </LinearLayout>

        <View
            android:id="@+id/divider_light"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:background="?attr/colorBottomSheetDivider"
            app:bgColorResByMode="@{R.color.color_bottom_sheet_divider}"
            app:isNightMode="@{vm.isNightMode}" />

        <!-- Option: System Default -->
        <LinearLayout
            android:id="@+id/btn_theme_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_14sdp">

            <TextView
                android:id="@+id/tv_theme_system_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_system"
                android:textColor="?attr/colorTextPrimary"
                app:textColorResByMode="@{R.color.color_text_primary}"
                app:isNightMode="@{vm.isNightMode}"
                android:textSize="16sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />

            <ImageView
                android:id="@+id/iv_check_system"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_circle_outline" />
        </LinearLayout>

        <View
            android:id="@+id/divider_system"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:background="?attr/colorBottomSheetDivider"
            app:bgColorResByMode="@{R.color.color_bottom_sheet_divider}"
            app:isNightMode="@{vm.isNightMode}" />

        <!-- Option: Cancel -->
        <LinearLayout
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_12sdp">

            <TextView
                android:id="@+id/tv_cancel_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="?attr/colorTextCancel"
                app:textColorResByMode="@{R.color.color_text_cancel}"
                app:isNightMode="@{vm.isNightMode}"
                android:textSize="16sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />
        </LinearLayout>

    </LinearLayout>
</layout>
