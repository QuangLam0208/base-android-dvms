<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="a"
            type="com.base.android.ui.main.qrscan.QRScanActivity" />
        <variable
            name="vm"
            type="com.base.android.ui.main.qrscan.QRScanViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background">

        <!-- Camera preview: full screen -->
        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcode_scanner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Top bar overlay -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingTop="@dimen/_24sdp"
            android:paddingBottom="@dimen/_12sdp"
            android:background="#99000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_drop_down"
                android:rotation="90"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{() -> a.onBackClick()}"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/qr_scan_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center"
                app:fontFamily="@font/sf_pro_display_semibold"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textFontWeight="600" />

            <!-- Invisible spacer to balance the back button -->
            <View
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp" />

        </LinearLayout>

        <!-- Result card (GONE by default, shown after scan) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            app:cardBackgroundColor="@color/course_card_background"
            app:cardCornerRadius="@dimen/_13sdp"
            app:cardElevation="4dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btn_pick_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_scan_result_label"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:alpha="0.7"
                    app:fontFamily="@font/sf_pro_display_regular"
                    android:fontFamily="@font/sf_pro_display_regular" />

                <TextView
                    android:id="@+id/tv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textIsSelectable="true"
                    app:fontFamily="@font/sf_pro_display_medium"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textFontWeight="500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_again"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_44sdp"
                    android:onClick="@{() -> a.onScanAgainClick()}"
                    android:text="@string/qr_scan_again"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:fontFamily="@font/sf_pro_display_semibold"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textFontWeight="600"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_qr_code"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/_8sdp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pick from gallery button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_image"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_32sdp"
            android:onClick="@{() -> a.onPickImageClick()}"
            android:text="@string/qr_scan_pick_image"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_gallery"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_8sdp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
