<?xml version="1.0" encoding="utf-8"?>
<!-- Shared loading affordance (FR-011): a centered dark-translucent rounded square with a single
     centered spinner. The hosting Dialog window is made transparent in DialogUtils so only this
     square shows over the dimmed screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loading_overlay"
    android:padding="@dimen/_12sdp">

    <ImageView
        android:id="@+id/iv_loading_spinner"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_loading_spinner" />
</FrameLayout>
