<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:backgroundTint="?attr/colorBottomSheetBackground"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_24sdp">

    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:text="@string/webview_demo_title"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="18sp"
        app:fontFamily="@font/sf_pro_display_semibold"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:textFontWeight="600" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_14sdp"
        android:text="@string/webview_demo_subtitle"
        android:textColor="@color/login_icon_tint"
        android:textSize="13sp"
        app:fontFamily="@font/sf_pro_display_regular"
        android:fontFamily="@font/sf_pro_display_regular" />

    <!-- Option 1: Tuổi Trẻ -->
    <LinearLayout
        android:id="@+id/btn_demo_tuoitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_13sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_courses"
            app:tint="@color/primary_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/webview_demo_tuoitre"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://tuoitre.vn"
                android:textColor="@color/login_icon_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:rotation="270"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/login_icon_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="?attr/colorBottomSheetDivider" />

    <!-- Option 2: Facebook -->
    <LinearLayout
        android:id="@+id/btn_demo_facebook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_13sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_web"
            app:tint="#1877F2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/webview_demo_facebook"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                app:fontFamily="@font/sf_pro_display_medium"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textFontWeight="500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://www.facebook.com"
                android:textColor="@color/login_icon_tint"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:rotation="270"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/login_icon_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="?attr/colorBottomSheetDivider" />

    <!-- Option 4: Custom URL -->
    <LinearLayout
        android:id="@+id/btn_demo_custom_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_13sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_open_in_browser"
            app:tint="?attr/colorTextPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:text="@string/webview_demo_custom_url"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="15sp"
            app:fontFamily="@font/sf_pro_display_medium"
            android:fontFamily="@font/sf_pro_display_medium"
            android:textFontWeight="500" />

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:rotation="270"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/login_icon_tint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:background="?attr/colorBottomSheetDivider" />

    <!-- Cancel -->
    <LinearLayout
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_12sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="?attr/colorTextCancel"
            android:textSize="16sp"
            app:fontFamily="@font/sf_pro_display_medium"
            android:fontFamily="@font/sf_pro_display_medium"
            android:textFontWeight="500" />
    </LinearLayout>

</LinearLayout>
