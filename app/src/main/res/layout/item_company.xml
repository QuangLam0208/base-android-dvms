<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.base.android.R" />

        <variable
            name="isNightMode"
            type="Boolean" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardBgColorResByMode="@{R.color.color_card_background}"
        app:isNightMode="@{isNightMode}"
        app:cardCornerRadius="@dimen/_13sdp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_17sdp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                app:cardBgColorResByMode="@{R.color.color_card_background}"
                app:isNightMode="@{isNightMode}"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/iv_company_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Company Logo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_company" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_company_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorTextPrimary"
                    app:textColorResByMode="@{R.color.color_text_primary}"
                    app:isNightMode="@{isNightMode}"
                    android:textSize="18sp"
                    app:fontFamily="@font/sf_pro_display_medium"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textFontWeight="500"
                    tools:text="TMA Solutions" />

                <TextView
                    android:id="@+id/tv_company_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Đối tác doanh nghiệp"
                    android:textColor="@color/accent_color"
                    android:textSize="13sp"
                    app:fontFamily="@font/sf_pro_display_semibold"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textFontWeight="600" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>