<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.base.android.R" />

        <variable
            name="f"
            type="com.base.android.ui.main.account.profile.ProfileFragment" />

        <variable
            name="vm"
            type="com.base.android.ui.main.account.profile.ProfileViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorScreenBackground"
        app:bgColorResByMode="@{R.color.color_screen_background}"
        app:isNightMode="@{vm.isNightMode}">

        <!-- Header Bar -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:text="@string/profile_title"
            android:textColor="?attr/colorTextPrimary"
            app:textColorResByMode="@{R.color.color_text_primary}"
            app:isNightMode="@{vm.isNightMode}"
            android:textSize="20sp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- User Info Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_user_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_24sdp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardBgColorResByMode="@{R.color.color_card_background}"
            app:isNightMode="@{vm.isNightMode}"
            app:cardCornerRadius="@dimen/_13sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <LinearLayout
                android:id="@+id/layout_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_20sdp">

                <FrameLayout
                    android:id="@+id/layout_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:onClick="@{() -> f.onAvatarClick()}">

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="@dimen/_64sdp"
                        android:layout_height="@dimen/_64sdp"
                        android:contentDescription="@string/profile_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile" />

                    <ImageView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_camera"
                        android:contentDescription="@string/choose_avatar_title"
                        android:padding="@dimen/_4sdp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/login_label_username"
                    android:textColor="?attr/colorTextPrimary"
                    app:textColorResByMode="@{R.color.color_text_primary}"
                    app:isNightMode="@{vm.isNightMode}"
                    android:textSize="18sp"
                    app:fontFamily="@font/sf_pro_display_medium"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textFontWeight="500" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:cardBgColorResByMode="@{R.color.color_card_background}"
            app:isNightMode="@{vm.isNightMode}"
            app:cardCornerRadius="@dimen/_13sdp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_user_info">

            <LinearLayout
                android:id="@+id/layout_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Language Row -->
                <LinearLayout
                    android:id="@+id/layout_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:onClick="@{() -> f.onLanguageClick()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_17sdp">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/language"
                        android:src="@drawable/ic_language"
                        app:tint="?attr/colorTextPrimary"
                        app:tintColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:text="@string/language"
                        android:textColor="?attr/colorTextPrimary"
                        app:textColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}"
                        android:textSize="16sp"
                        app:fontFamily="@font/sf_pro_display_regular"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:textFontWeight="400" />

                    <TextView
                        android:id="@+id/tv_current_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:text="@{vm.currentLanguageDisplay}"
                        android:textColor="@color/accent_color"
                        android:textSize="15sp"
                        app:fontFamily="@font/sf_pro_display_medium"
                        android:fontFamily="@font/sf_pro_display_medium"
                        android:textFontWeight="500" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:rotation="270"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/login_icon_tint" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="?attr/colorDivider"
                    app:bgColorResByMode="@{R.color.color_divider}"
                    app:isNightMode="@{vm.isNightMode}" />

                <!-- QR Scan Row -->
                <LinearLayout
                    android:id="@+id/layout_qr_scan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:onClick="@{() -> f.onQRScanClick()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_17sdp">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/qr_scan_title"
                        android:src="@drawable/ic_qr_code"
                        app:tint="?attr/colorTextPrimary"
                        app:tintColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:text="@string/qr_scan_title"
                        android:textColor="?attr/colorTextPrimary"
                        app:textColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}"
                        android:textSize="16sp"
                        app:fontFamily="@font/sf_pro_display_regular"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:textFontWeight="400" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:rotation="270"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/login_icon_tint" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="?attr/colorDivider"
                    app:bgColorResByMode="@{R.color.color_divider}"
                    app:isNightMode="@{vm.isNightMode}" />

                <!-- Theme Row -->
                <LinearLayout
                    android:id="@+id/layout_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:onClick="@{() -> f.onThemeClick()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_17sdp">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/theme"
                        android:src="@drawable/ic_theme"
                        app:tint="?attr/colorTextPrimary"
                        app:tintColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:text="@string/theme"
                        android:textColor="?attr/colorTextPrimary"
                        app:textColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}"
                        android:textSize="16sp"
                        app:fontFamily="@font/sf_pro_display_regular"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:textFontWeight="400" />

                    <TextView
                        android:id="@+id/tv_current_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:text="@{vm.currentThemeDisplay}"
                        android:textColor="@color/accent_color"
                        android:textSize="15sp"
                        app:fontFamily="@font/sf_pro_display_medium"
                        android:fontFamily="@font/sf_pro_display_medium"
                        android:textFontWeight="500" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:rotation="270"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/login_icon_tint" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:background="?attr/colorDivider"
                    app:bgColorResByMode="@{R.color.color_divider}"
                    app:isNightMode="@{vm.isNightMode}" />

                <!-- WebView Demo Row -->
                <LinearLayout
                    android:id="@+id/layout_webview_demo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:onClick="@{() -> f.onWebViewDemoClick()}"
                    android:orientation="horizontal"
                    android:padding="@dimen/_17sdp">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:contentDescription="@string/webview_demo_title"
                        android:src="@drawable/ic_web"
                        app:tint="?attr/colorTextPrimary"
                        app:tintColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:text="@string/webview_demo_title"
                        android:textColor="?attr/colorTextPrimary"
                        app:textColorResByMode="@{R.color.color_text_primary}"
                        app:isNightMode="@{vm.isNightMode}"
                        android:textSize="16sp"
                        app:fontFamily="@font/sf_pro_display_regular"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:textFontWeight="400" />

                    <ImageView
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:rotation="270"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/login_icon_tint" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_button_height"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_32sdp"
            android:backgroundTint="@color/color_logout_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:onClick="@{() -> f.handleLogout()}"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/_8sdp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>