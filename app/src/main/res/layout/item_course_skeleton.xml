<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_9sdp"
        android:layout_marginTop="@dimen/_9sdp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">

            <!-- Skeleton Image Banner -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/course_image_height"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Title Line 1 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/_14sdp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Title Line 2 (shorter) -->
            <View
                android:layout_width="220dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Price -->
            <View
                android:layout_width="140dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/_13sdp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Description Line 1 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="@dimen/_13sdp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Description Line 2 -->
            <View
                android:layout_width="260dp"
                android:layout_height="14dp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Skeleton Button -->
            <View
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_19sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:background="@drawable/bg_skeleton_rounded" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>