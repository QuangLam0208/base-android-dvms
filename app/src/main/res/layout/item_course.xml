<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:layout_marginTop="@dimen/_8sdp"
    app:cardBackgroundColor="@color/course_card_background"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/course_image_height"
            app:cardBackgroundColor="@color/course_card_background"
            app:cardCornerRadius="@dimen/course_image_corner_radius"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_course_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Khoá học"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_course_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/course_name_text_size"
            android:letterSpacing="0"
            app:lineHeight="20sp"
            app:fontFamily="@font/sf_pro_display_medium"
            android:fontFamily="@font/sf_pro_display_medium"
            android:textFontWeight="500"
            tools:text="Khoá học ReactJS — Xây dựng chức năng Github với GraphQL" />

        <TextView
            android:id="@+id/tv_course_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:textColor="@color/accent_color"
            android:textSize="@dimen/course_price_text_size"
            android:letterSpacing="0"
            app:lineHeight="25sp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600"
            tools:text="7,500,000 đ" />

        <TextView
            android:id="@+id/tv_course_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/course_short_description"
            android:textSize="@dimen/course_description_text_size"
            android:letterSpacing="0"
            app:lineHeight="@dimen/course_description_line_height"
            app:fontFamily="@font/sf_pro_display_regular"
            android:fontFamily="@font/sf_pro_display_regular"
            android:textFontWeight="400"
            tools:text="Lazy loading · code splitting · Memoization trong ReactJS. Tìm hiểu GraphQL và so sánh với REST." />

        <TextView
            android:id="@+id/btn_view_more"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:layout_marginLeft="@dimen/_2sdp"
            android:background="@drawable/bg_btn_view_more"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/button_more"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            app:lineHeight="26.4sp"
            app:fontFamily="@font/sf_pro_display_semibold"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textFontWeight="600"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:drawableTint="@color/white"
            android:drawablePadding="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>