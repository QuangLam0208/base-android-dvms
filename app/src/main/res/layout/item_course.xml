<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:layout_marginTop="@dimen/_8sdp"
    app:cardBackgroundColor="@color/course_card_background"
    app:cardCornerRadius="@dimen/_13sdp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_17sdp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_196sdp"
            app:cardBackgroundColor="@color/course_card_background"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_course_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Khoá học"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_course_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_19sdp"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/course_name_text_size"
            android:textStyle="bold"
            tools:text="Khoá học ReactJS — Xây dựng chức năng Github với GraphQL" />

        <TextView
            android:id="@+id/tv_course_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:textColor="@color/accent_color"
            android:textSize="@dimen/course_price_text_size"
            android:textStyle="bold"
            tools:text="7,500,000 đ" />

        <TextView
            android:id="@+id/tv_course_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/_3sdp"
            android:maxLines="2"
            android:textColor="@color/course_short_description"
            android:textSize="@dimen/course_description_text_size"
            tools:text="Lazy loading · code splitting · Memoization trong ReactJS. Tìm hiểu GraphQL và so sánh với REST." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_more"
            android:layout_width="@dimen/course_button_width"
            android:layout_height="@dimen/course_button_height"
            android:layout_marginTop="@dimen/course_button_margin_top"
            android:backgroundTint="@color/accent_color"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/_14sdp"
            android:text="@string/button_more"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/course_button_text_size"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_12sdp"
            app:icon="@drawable/ic_arrow_drop_down"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/_4sdp"
            app:iconTint="@color/white" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>